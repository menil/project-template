# Project Task Runner

# List available recipes
default:
    @just --list

# Format code and configuration files
format:
    @echo "No formatter configured yet. Customize this recipe in the Justfile!"

# Run code and markdown linting checks
lint:
    @echo "No linter configured yet. Customize this recipe in the Justfile!"

# Run all local checks (tests, format checks, lints)
validate: lint

# One-time GitHub setup for the issue automation: the repository setting that lets
# workflows open pull requests, and the labels a person applies. Needs gh, logged in as
# an admin of the repository.
setup-github:
    @if [ -x scripts/setup-github.sh ]; then scripts/setup-github.sh; else echo "This project was generated without the issue automation."; fi
